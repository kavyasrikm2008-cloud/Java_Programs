package p2;

import p1.Employee;

public class PartTimeEmployee extends Employee {
    
    int workinghrs;
    double rateperhr;
    
    public PartTimeEmployee(String name, int age, int workinghrs, double rateperhr)
    {
        super(name,age);
        this.workinghrs = workinghrs;
        this.rateperhr = rateperhr;
    }
    public double calculatePay()
    {
        return workinghrs*rateperhr;
    }
    public void display()
    {
        System.out.println("name: " +name);
        System.out.println("age: " +age);
        System.out.println("working hours: " +workinghrs);
        System.out.println("rateperhr: " +rateperhr);
        System.out.println("salary: " +calculatePay());
    }
    
}



