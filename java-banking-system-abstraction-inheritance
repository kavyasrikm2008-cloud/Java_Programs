import java.util.*;
abstract class Account
{
    int accountID;
    int customerID;
 
 Account(int accountID, int customerID)
 {
     this.accountID = accountID;
     this.customerID = customerID;
 }
 //abstract methods
 abstract double deposit(int accountID, double depositAmt);
 abstract double withdraw(int accountID, double withdrawAmt);
 
}
class SavingAccount extends Account 
{
    double balance;
    SavingAccount(int accountID, int customerID, double balance)
    {
        super(accountID, customerID);
        this.balance = balance;
        
    }
    double deposit(int accountID, double depositAmt)
    {
        if(this.accountID == accountID)
        {
            balance += depositAmt;
            return balance;
        }
        else
        {
            System.out.println("invalid account");
            return -1;
        }
    }
    
    double withdraw(int accountID, double withdrawAmt)
    {
        if(this.accountID!=accountID)
        {
